# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Madeenas Stock
NEXT_PUBLIC_APP_URL=https://madeenas.vercel.app
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────────
WHATSAPP_API_TOKEN=your-meta-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_TRANSFER_APPROVAL_TEMPLATE=transfer_approval_required
WHATSAPP_TRANSFER_DISPATCHED_TEMPLATE=transfer_dispatched
WHATSAPP_LOW_STOCK_TEMPLATE=low_stock_alert

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@madeenas.lk

# ── Supabase Storage ──────────────────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=madeenas-assets

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_WHATSAPP_NOTIFICATIONS=true
ENABLE_LOW_STOCK_ALERTS=true
